# Copy to .env.local and fill in. Never commit .env.local — it holds secrets.
# In Vercel, add the same variables under Settings → Environment Variables.

# Supabase (Project Settings → Data API / API Keys). Server-only key — never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secrets — generate each with: openssl rand -hex 32
REGISTER_API_KEY=
TABLE_TOKEN_SECRET=
STAFF_SESSION_SECRET=

# What staff type to log in to /register
STAFF_PASSCODE=

# Where table QR codes point (npm run qr). Local only — not needed in Vercel.
SITE_URL=http://localhost:3000
